<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>IpcConfig</AssemblyName>
    <Authors>Jeremias0618</Authors>
    <Description>ASF plugin: read/write config/IPC.config via /Api/IpcConfig</Description>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>IpcConfig</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0.0</Version>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1903;NU1902;NU1901;NU1904</NoWarn>
    <!-- Must match ArchiSteamFarm.exe FileVersion (strong-name). Override: -p:ASFTargetVersion=x.y.z.w -->
    <ASFTargetVersion Condition="'$(ASFTargetVersion)' == ''">6.3.8.4</ASFTargetVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only refs like official ASF plugins; no FrameworkReference (avoids OpenAPI analyzers / type mismatch). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10">
      <IncludeAssets>compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>analyzers;build;buildTransitive;runtime;native;contentfiles</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.Composition.AttributedModel" Version="10.0.10">
      <IncludeAssets>compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ArchiSteamFarm\ArchiSteamFarm\ArchiSteamFarm.csproj" ExcludeAssets="all" Private="false" AdditionalProperties="Version=$(ASFTargetVersion);AssemblyVersion=$(ASFTargetVersion);FileVersion=$(ASFTargetVersion);InformationalVersion=$(ASFTargetVersion)" />
  </ItemGroup>
</Project>
